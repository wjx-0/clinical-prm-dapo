# Copy to .env and fill in your own key.

TEACHER_BACKEND=local
TEACHER_BASE_URL=https://api.penguinsaichat.dpdns.org/v1
TEACHER_MODEL_NAME=gpt-5.5
TEACHER_API_KEY=replace-me

# Optional LLM-as-judge / spot-check backend.
JUDGE_BASE_URL=https://api.deepseek.com/v1
JUDGE_MODEL_NAME=deepseek-chat
JUDGE_API_KEY=replace-me

# The judge script also accepts these aliases.
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_NAME=deepseek-chat
DEEPSEEK_API_KEY=replace-me
